# Copy this file to .env and adjust its values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=demo
DB_TEST_NAME=stockops_test
ADMIN_APP_ID_INDEX=1
PDT_APP_ID_INDEX=2
# WAJIB di produksi (npm start): nilai acak minimal 32 karakter, mis. hasil perintah
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server menolak berjalan dengan nilai contoh ini atau nilai yang terlalu pendek.
# PERHATIAN: mengganti nilai ini mencabut SEMUA kredensial ter-cache di semua device
# (semua user wajib login online ulang).
CREDENTIAL_HMAC_SECRET=ganti-dengan-kunci-rahasia-anda
SESSION_TTL_DAYS=7
CREDENTIAL_TTL_DAYS=30
RECEIVE_DOC_PREFIX=IN

# HTTPS untuk npm start (disarankan untuk PDT): isi di environment shell, BUKAN di file ini,
# karena scripts/serve.mjs tidak membaca .env. Contoh PowerShell:
#   $env:TLS_CERT_FILE='C:\stockops-cert\cert.pem'; $env:TLS_KEY_FILE='C:\stockops-cert\key.pem'; npm start
