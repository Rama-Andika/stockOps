# Copy this file to .env and adjust its values.
DB_HOST=127.0.0.1
DB_PORT=3306
# Produksi: pakai user database khusus dengan hak minimal (bukan root) dan password tidak kosong.
# Nilai root/root di bawah hanya untuk pengembangan lokal.
DB_USER=root
DB_PASSWORD=root
DB_NAME=demo
DB_TEST_NAME=stockops_test
ADMIN_APP_ID_INDEX=1
PDT_APP_ID_INDEX=2
# WAJIB di produksi (npm start): nilai acak minimal 32 karakter, mis. hasil perintah
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dengan nilai contoh ini atau nilai yang terlalu pendek, server tetap menyala tetapi menolak membuka
# koneksi database: login PDT gagal dan alasannya ("[env] Konfigurasi produksi tidak aman") tercetak
# di konsol server saat permintaan pertama masuk.
# PERHATIAN: mengganti nilai ini mencabut SEMUA kredensial ter-cache di semua device
# (semua user wajib login online ulang).
CREDENTIAL_HMAC_SECRET=ganti-dengan-kunci-rahasia-anda
SESSION_TTL_DAYS=7
CREDENTIAL_TTL_DAYS=30
RECEIVE_DOC_PREFIX=IN

# HTTPS untuk npm start (wajib bila PDT mengakses lewat IP LAN): isi TLS_CERT_FILE dan TLS_KEY_FILE
# di environment shell, BUKAN di file ini, karena scripts/serve.mjs tidak membaca .env (begitu juga PORT).
# Keduanya harus diisi bersamaan. Contoh PowerShell:
#   $env:TLS_CERT_FILE='C:\stockops-cert\cert.pem'; $env:TLS_KEY_FILE='C:\stockops-cert\key.pem'; npm start
