# ============================================================
# StockOps - Staging Environment Configuration Template
# Copy to .env.staging (or on server: stockops.env) and set real credentials.
# ============================================================

# --- Server Runtime ---
PORT=5006
TZ=Asia/Makassar

# --- Subpath / Multi-Client Deployment ---
# URL prefix baked into build and handled by Nginx reverse proxy
STOCKOPS_BASE_PATH=/oxy-stockops-unclejo.dev

# --- Staging Database (Trial ERP Database) ---
# Note: Target server uses port 3310 instead of 3306.
# For Docker deployments, set DB_HOST=host.docker.internal instead of 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=oxy
DB_PASSWORD=replace_with_staging_db_password
DB_NAME=oxysystem_unclejo_trial

# --- ID Scheme (BR-8, BR-17) ---
ADMIN_APP_ID_INDEX=1
PDT_APP_ID_INDEX=2

# --- Offline Credential Security (BR-19) ---
# Cryptographically strong HMAC secret (distinct from production).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_HMAC_SECRET=replace_with_random_32_plus_char_secret_for_staging

# --- Session Policies ---
SESSION_TTL_DAYS=7
CREDENTIAL_TTL_DAYS=30

# --- Document Numbering ---
RECEIVE_DOC_PREFIX=IN
